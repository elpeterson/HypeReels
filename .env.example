# HypeReels — Environment Variable Reference
# Copy this file to .env and fill in values before running docker compose up.
#
# Usage:
#   cp .env.example .env
#   # Edit .env as needed
#   docker compose up
#
# Variable names referenced by docker-compose.yml — never commit real secrets.

# ─── Redis ────────────────────────────────────────────────────────────────────
# Connection URL for the Redis instance used by BullMQ and session KV.
# Default inside Docker Compose: redis://redis:6379
REDIS_URL=redis://redis:6379

# ─── MinIO (object storage) ───────────────────────────────────────────────────
# Internal endpoint for the MinIO service (used by the app container).
# Must be reachable from within the Docker network.
MINIO_ENDPOINT=http://minio:9000

# MinIO access credentials — also used as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
# for the MinIO container itself. Change from defaults in any production-like env.
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin

# Name of the S3 bucket where all session assets are stored.
MINIO_BUCKET=hypereels

# MinIO server credentials (used to start the MinIO container and init the bucket).
# Must match MINIO_ACCESS_KEY_ID / MINIO_SECRET_ACCESS_KEY above.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ─── GPU acceleration (optional — CPU is the default) ────────────────────────
# FFmpeg hardware encoder.
#   Leave empty (default) → software x264 encoding.
#   Set to "nvenc" on a machine with an NVIDIA GPU + NVIDIA Container Toolkit
#   to use NVENC hardware encoding. Falls back to x264 automatically if CUDA
#   is unavailable at runtime.
#
# AMD ROCm and Apple Metal are NOT supported — CPU path is used on those hosts.
FFMPEG_HWACCEL=

# InsightFace ONNX execution provider for person detection.
#   Default: CPUExecutionProvider (works on all hardware)
#   Set to "CUDAExecutionProvider" on NVIDIA GPU hosts for faster detection.
#   Falls back to CPU automatically if CUDA init fails.
#
# AMD ROCm and Apple Silicon Neural Engine are NOT supported.
INSIGHTFACE_PROVIDERS=CPUExecutionProvider

# ─── Application ──────────────────────────────────────────────────────────────
# Public base URL used by the browser to reach the API.
# For local development: http://localhost:3000
# For a LAN-accessible deployment: http://<host-ip>:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Node.js environment. Always "production" for docker compose deployments.
NODE_ENV=production
